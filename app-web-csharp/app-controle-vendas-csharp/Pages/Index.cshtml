@page
@model IndexModel
@{
    ViewData["Title"] = "Início";
}

<section class="card hero">
    <h1>Sistema de Controle de Vendas e Estoque</h1>
    <p class="muted">Registre vendas de sorvetes com pagamento em Dinheiro ou Pix.</p>
    <form method="post" asp-page-handler="StartSale">
        <button type="submit" class="btn btn-primary btn-lg">Realizar Venda</button>
    </form>
</section>
