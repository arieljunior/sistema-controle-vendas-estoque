@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

<section class="card">
    <h1>Ocorreu um erro</h1>
    <p>Não foi possível processar a requisição. Tente novamente.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">ID da requisição: <code>@Model.RequestId</code></p>
    }
    <a class="btn" asp-page="/Index">Voltar ao início</a>
</section>
